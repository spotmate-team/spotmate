<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_mypage_card"
    android:padding="20dp">

    <!-- 상단 제목 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="프로필 수정"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1B2410"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- 프로필 사진 -->
    <FrameLayout
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/edit_profile_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_profile_circle"
            android:scaleType="centerCrop"
            android:contentDescription="프로필 사진" />

        <TextView
            android:id="@+id/btn_change_photo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:gravity="center"
            android:text="✎"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:background="#456A0B"
            android:contentDescription="사진 변경" />

    </FrameLayout>

    <!-- 닉네임 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="닉네임"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1B2410"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edit_nickname"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#EEF1E3"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:textColor="#1B2410"
        android:hint="닉네임을 입력하세요"
        android:singleLine="true" />

    <!-- 자기소개 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="자기소개"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1B2410"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edit_introduction"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="#EEF1E3"
        android:padding="12dp"
        android:gravity="top"
        android:textSize="14sp"
        android:textColor="#1B2410"
        android:hint="자기소개를 입력하세요"
        android:inputType="textMultiLine"
        android:maxLines="4" />

    <!-- 하단 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btn_cancel_edit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="취소"
            android:textColor="#456A0B"
            android:backgroundTint="#EEF1E3" />

        <Button
            android:id="@+id/btn_save_edit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="저장"
            android:textColor="#FFFFFF"
            android:backgroundTint="#456A0B" />

    </LinearLayout>

</LinearLayout>